 std::vector<double> Matrix::SumPerColumn() const {
+    // Minimal counting iterator: yields 0, 1, 2, ... as std::size_t.
+    // Only the operations std::transform / std::accumulate need.
+    struct CountIter {
+        using iterator_category = std::input_iterator_tag;
+        using value_type = std::size_t;
+        using difference_type = std::ptrdiff_t;
+        using pointer = const std::size_t*;
+        using reference = std::size_t;
+
+        std::size_t i = 0;
+        std::size_t operator*() const { return i; }
+        CountIter& operator++() { ++i; return *this; }
+        bool operator!=(const CountIter& other) const { return i != other.i; }
+    };
+
     std::vector<double> result(cols_, 0.0);
-    for (std::size_t c = 0; c < cols_; ++c) {
-        double s = 0.0;
-        for (std::size_t r = 0; r < rows_; ++r) {
-            s += at(r, c);
-        }
-        result[c] = s;
-    }
+    std::transform(
+        CountIter{0}, CountIter{cols_}, result.begin(),
+        [this](std::size_t c) {
+            return std::accumulate(
+                CountIter{0}, CountIter{rows_}, 0.0,
+                [this, c](double acc, std::size_t r) {
+                    return acc + at(r, c);
+                });
+        });
     return result;
 }
 
