+// Per-column sum: walk row by row so the inner loop is contiguous in memory.
+// The naive column-major variant strides by `cols_` doubles per access and
+// blows the L1 cache on wide matrices; here every inner-loop access is
+// data_[r * cols_ + c] for consecutive c, which is a single cache-line
+// friendly sweep through the row.
 std::vector<double> Matrix::SumPerColumn() const {
     std::vector<double> result(cols_, 0.0);
-    for (std::size_t c = 0; c < cols_; ++c) {
-        double s = 0.0;
-        for (std::size_t r = 0; r < rows_; ++r) {
-            s += at(r, c);
+    for (std::size_t r = 0; r < rows_; ++r) {
+        const double* row = data_.data() + r * cols_;
+        for (std::size_t c = 0; c < cols_; ++c) {
+            result[c] += row[c];
         }
-        result[c] = s;
     }
     return result;
 }
